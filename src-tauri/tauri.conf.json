{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "open-ui",
  "version": "0.1.2",
  "identifier": "io.github.harukoto-project.open-ui",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "open-ui",
        "width": 1200,
        "height": 720,
        "minWidth": 640,
        "minHeight": 480,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:",
      "devCsp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost ws://localhost:1420 http://localhost:1420; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDgxQkQwMzI3QzJBMDBGNDEKUldSQkQ2RENKd085Z1hHbzhzaWkrY09GdkJBNkk0Sk9ObXJHWGoycUpoTm1IT2RNMTduWFBzZHkK",
      "endpoints": [
        "https://github.com/Harukotokoto/open-ui/releases/latest/download/latest.json"
      ]
    }
  }
}
